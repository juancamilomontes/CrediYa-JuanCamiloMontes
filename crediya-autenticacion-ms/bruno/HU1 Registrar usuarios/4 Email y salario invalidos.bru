meta {
  name: 4 Email y salario invalidos
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Luis",
    "apellido": "Perez",
    "email": "luis@",
    "documento_identidad": "1122334455",
    "id_rol": 3,
    "salario_base": 20000000
  }
}

assert {
  res.status: eq 400
  res.body.errors: length 2
}
