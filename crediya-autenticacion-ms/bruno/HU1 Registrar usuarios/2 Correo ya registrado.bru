meta {
  name: 2 Correo ya registrado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Otra",
    "apellidos": "Persona",
    "correo_electronico": "JUAN@mail.com",
    "salario_base": 1000000
  }
}

assert {
  res.status: eq 409
}

docs {
  juan@mail.com ya existe en la base. El correo se compara sin importar mayúsculas.
}
