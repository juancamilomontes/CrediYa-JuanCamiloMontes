meta {
  name: 1 Registrar usuario valido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Maria",
    "apellidos": "Lopez",
    "fecha_nacimiento": "1998-03-22",
    "direccion": "Carrera 7 # 45-10",
    "telefono": "3105551234",
    "correo_electronico": "maria{{$timestamp}}@mail.com",
    "salario_base": 4200000
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

docs {
  Registra un usuario válido. El correo usa {{$timestamp}} para que sea distinto
  cada vez y puedas enviarla varias veces sin que responda 409.
}
